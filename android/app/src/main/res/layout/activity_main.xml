<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F9"
    android:padding="20dp">

    <!-- Cabeçalho -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Conect Solutions TI"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1A237E"
        android:gravity="center"
        android:layout_marginTop="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Autenticação Biométrica Mobile -> VCL"
        android:textSize="14sp"
        android:textColor="#555555"
        android:gravity="center"
        android:layout_marginBottom="25dp" />

    <!-- Card de Configuração -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:padding="16dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IP do PC (Servidor VCL):"
            android:textStyle="bold"
            android:textColor="#333333" />

        <EditText
            android:id="@+id/edtPCIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex: 192.168.15.119 ou 127.0.0.1"
            android:text="192.168.15.119"
            android:inputType="textUri"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Porta TCP:"
            android:textStyle="bold"
            android:textColor="#333333" />

        <EditText
            android:id="@+id/edtPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="8080"
            android:inputType="number"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Usuário:"
            android:textStyle="bold"
            android:textColor="#333333" />

        <EditText
            android:id="@+id/edtUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="mauricio"
            android:inputType="textPersonName" />
    </LinearLayout>

    <!-- Botão de Ação -->
    <Button
        android:id="@+id/btnAutenticar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="VALIDAR BIOMETRIA E LIBERAR VCL"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1A237E"
        android:layout_marginBottom="16dp" />

    <!-- Status Feedback -->
    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pronto para autenticar. Toque no botão acima."
        android:textSize="14sp"
        android:textColor="#333333"
        android:gravity="center"
        android:padding="10dp"
        android:background="#E8EAF6"
        android:layout_marginBottom="12dp" />

    <!-- Log de Rede -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#263238"
        android:padding="10dp">

        <TextView
            android:id="@+id/txtLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[Console de Comunicação HTTP]\n"
            android:textColor="#80CBC4"
            android:fontFamily="monospace"
            android:textSize="12sp" />
    </ScrollView>

</LinearLayout>

